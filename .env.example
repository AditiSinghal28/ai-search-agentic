APP_NAME=medical_ai_search_agentic
API_HOST=127.0.0.1
API_PORT=8001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mbs
DB_USER=root
DB_PASSWORD=

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=90

DEFAULT_CURRENCY=RM
MAX_SQL_ROWS=200
SQL_RETRY_COUNT=2
ACTIVE_BOOKING_STATUSES=pending,accepted,rescheduled,completed

# Optional LLM provider: ollama | openai | none
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60

# Auto-create AI query log + feedback tables in the same MySQL DB used by Laravel.
# Set false when you create the tables using the Laravel migration in the medical booking system.
AUTO_CREATE_AI_TABLES=false
